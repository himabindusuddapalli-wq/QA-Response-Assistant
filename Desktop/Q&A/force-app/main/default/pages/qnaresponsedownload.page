<apex:page controller="QnaDownloadController"
           contentType="{!contentType}"
           showHeader="false" sidebar="false"
           standardStylesheets="false"
           applyHtmlTag="false" applyBodyTag="false"
           cache="true">
<html xmlns:o="urn:schemas-microsoft-com:office:office"
      xmlns:w="urn:schemas-microsoft-com:office:word"
      xmlns="http://www.w3.org/TR/REC-html40">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
    <title>{!docName}</title>
    <!--[if gte mso 9]><xml>
    <w:WordDocument>
        <w:View>Print</w:View>
        <w:Zoom>100</w:Zoom>
        <w:DoNotOptimizeForBrowser/>
    </w:WordDocument>
    </xml><![endif]-->
    <style type="text/css">
        p.MsoFooter, li.MsoFooter, div.MsoFooter {
            margin: 0in;
            margin-bottom: .0001pt;
            mso-pagination: widow-orphan;
            tab-stops: center 3.0in right 6.0in;
        }
        @page Section1 {
            size: 8.5in 11.0in;
            margin: 1.0in 1.0in 0.8in 1.0in;
            mso-footer: f1;
            mso-footer-margin: 0.5in;
            mso-paper-source: 0;
        }
        div.Section1 { page: Section1; }
        table#hrdftrtbl { margin: 0in 0in 0in 9in; }
        body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color:#1a1a1a; }
    </style>
</head>
<body>
    <div class="Section1">

        <!-- ================= COVER METADATA (horizontal) ================= -->
        <table cellspacing="0" cellpadding="8"
               style="border-collapse:collapse; width:100%; margin:0 0 8pt; border:1px solid #cfe0f4;">
            <tr style="background-color:#eaf2fc;">
                <td style="font-weight:bold; color:#1a3558; border:1px solid #cfe0f4;">Q&amp;A Document</td>
                <td style="font-weight:bold; color:#1a3558; border:1px solid #cfe0f4;">Company</td>
                <td style="font-weight:bold; color:#1a3558; border:1px solid #cfe0f4;">RFP</td>
                <td style="font-weight:bold; color:#1a3558; border:1px solid #cfe0f4;">Generated By</td>
                <td style="font-weight:bold; color:#1a3558; border:1px solid #cfe0f4;">Generated On</td>
                <td style="font-weight:bold; color:#1a3558; border:1px solid #cfe0f4;">Total Questions</td>
            </tr>
            <tr>
                <td style="border:1px solid #cfe0f4;">{!docName}</td>
                <td style="border:1px solid #cfe0f4;">{!company}</td>
                <td style="border:1px solid #cfe0f4;">{!rfpName}</td>
                <td style="border:1px solid #cfe0f4;">{!generatedBy}</td>
                <td style="border:1px solid #cfe0f4;">{!generatedOn}</td>
                <td style="border:1px solid #cfe0f4;">{!totalQuestions}</td>
            </tr>
        </table>

        <apex:outputText rendered="{!maName != ''}" escape="false">
            <p style="margin:0 0 16pt; font-size:10.5pt; color:#1e293b;">
                <span style="font-weight:bold; color:#1a3558;">Membership Activity:&nbsp;</span>{!maName}
            </p>
        </apex:outputText>

        <!-- ================= WORD LAYOUT ================= -->
        <apex:outputPanel layout="none" rendered="{!isWord}">
            <apex:repeat value="{!rows}" var="r">
                <apex:outputText rendered="{!r.section != null}" escape="false">
                    <p style="font-size:12pt; font-weight:bold; color:#3d7ac7; margin:16pt 0 4pt;">{!r.section}</p>
                </apex:outputText>
                <p style="font-weight:bold; margin:6pt 0 2pt;">
                    <apex:outputText rendered="{!r.qNo != null}">{!r.qNo}. </apex:outputText>{!r.question}
                </p>
                <div style="margin:0 0 14pt; text-align:justify;">
                    <apex:outputText value="{!r.answer}" escape="false"/>
                </div>
            </apex:repeat>
        </apex:outputPanel>

        <!-- ================= EXCEL LAYOUT ================= -->
        <apex:outputPanel layout="none" rendered="{!isExcel}">
            <table border="1" cellspacing="0" cellpadding="5" style="border-collapse:collapse;">
                <thead>
                    <tr style="background-color:#3d7ac7; color:#ffffff; font-weight:bold;">
                        <th>#</th>
                        <th>Section</th>
                        <th>Question</th>
                        <th>Answer</th>
                    </tr>
                </thead>
                <tbody>
                    <apex:repeat value="{!rows}" var="r">
                        <tr style="vertical-align:top;">
                            <td>{!r.qNo}</td>
                            <td>{!r.section}</td>
                            <td>{!r.question}</td>
                            <td><apex:outputText value="{!r.answer}" escape="false"/></td>
                        </tr>
                    </apex:repeat>
                </tbody>
            </table>
        </apex:outputPanel>

        <!-- ============ FOOTER HOLDER (pushed off-page) ============ -->
        <apex:outputPanel layout="none" rendered="{!isWord}">
            <table id="hrdftrtbl" border="0" cellspacing="0" cellpadding="0">
                <tr>
                    <td>
                        <div style="mso-element:footer" id="f1">
                            <p class="MsoFooter"
                               style="border-top:0.75pt solid #cfe0f4; padding-top:4pt; font-size:8.5pt; color:#667085;">
                                Generated by Q&amp;A Response Assistant
                                <span style="mso-tab-count:1"></span>
                                Page <span style='mso-field-code: PAGE '></span> of <span style='mso-field-code: NUMPAGES '></span>
                            </p>
                        </div>
                    </td>
                </tr>
            </table>
        </apex:outputPanel>

    </div>
</body>
</html>
</apex:page>